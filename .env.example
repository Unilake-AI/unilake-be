# ===== Ứng dụng =====
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Chỉ dùng origin, không kèm đường dẫn /login; nhiều origin cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://unilake-fe.vercel.app
# Tùy chọn regex cho origin local/VPN khi test nhiều port (để trống nếu không dùng)
CORS_ORIGIN_REGEX=

# ===== PostgreSQL =====
DB_HOST=localhost
# Port mặc định trong Docker Compose (chỉnh 5432 hoặc 5434 tùy máy local)
DB_PORT=5434
DB_USER=unilake
DB_PASSWORD=your_db_password_here
DB_NAME=unilake
DB_ECHO=false
# Role chỉ đọc cho NLQ/Dashboard (chỉ SELECT trên schema gold)
DB_READONLY_USER=unilake_reader
DB_READONLY_PASSWORD=your_readonly_password_here
DB_STATEMENT_TIMEOUT_MS=5000
# Database giả lập hệ thống nguồn (Admissions/Training/HR)
DB_SOURCE_NAME=unilake_source

# ===== MinIO / S3 =====
# Không kèm http://
MINIO_ENDPOINT=localhost:9000
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD của container (mật khẩu >= 8 ký tự)
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# Runtime dùng SA riêng, tạo bằng app.infra.minio.service_accounts (xem docs).
# Secrets nằm trong .env.bronze-accounts.local / .env.source-reader.local,
# Compose nạp .env.bronze-backend.local và .env.bronze-worker.local theo service.
# Không đặt credentials root vào các file runtime này.

# ===== DuckDB =====
# :memory: cho backend (tránh khóa file); dùng đường dẫn file cho notebook/debug
DUCKDB_PATH=:memory:
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=2GB

# ===== JWT =====
# Production: tạo bằng `openssl rand -hex 32`
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== LLM =====
# mock | openai | anthropic (hiện backend luôn dùng mock)
LLM_PROVIDER=mock
# Điền key thật chỉ trong .env local, KHÔNG điền vào .env.example
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Kho tiếp nhận file tách riêng với Bronze. Chỉ file đạt kiểm tra mới được ghi vào Bronze.
MINIO_BUCKET_UPLOADS=ingestion-uploads
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_RECORDS=1000000
UPLOAD_MAX_COLUMNS=500
UPLOAD_MAX_CELL_CHARS=1000000
UPLOAD_TIMEOUT_SECONDS=60
UPLOAD_MAX_EXPANDED_BYTES=209715200
# Worker dùng dấu hiệu này để Docker nhận biết worker còn kết nối được hàng đợi.
INGESTION_WORKER_ID=ingestion-worker
WORKER_HEARTBEAT_SECONDS=10
WORKER_HEALTH_STALE_SECONDS=45
INGESTION_RETRY_MAX_ATTEMPTS=3
INGESTION_RETRY_FIRST_DELAY_SECONDS=10
INGESTION_RETRY_SECOND_DELAY_SECONDS=30
UPLOAD_STAGING_RETENTION_HOURS=168
# Tạo tài khoản bằng app.infra.minio.upload_accounts; không dùng tài khoản quản trị ở API/worker.
