# ===== Ứng dụng =====
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Nhiều origin cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000

# ===== PostgreSQL =====
DB_HOST=localhost
# Port mặc định trong Docker Compose (chỉnh 5432 hoặc 5434 tùy máy local)
DB_PORT=5434
DB_USER=unilake
DB_PASSWORD=your_db_password_here
DB_NAME=unilake
DB_ECHO=false
# Role chỉ đọc cho NLQ/Dashboard (chỉ SELECT trên schema gold)
DB_READONLY_USER=unilake_reader
DB_READONLY_PASSWORD=your_readonly_password_here
DB_STATEMENT_TIMEOUT_MS=5000
# Database giả lập hệ thống nguồn (Admissions/Training/HR)
DB_SOURCE_NAME=unilake_source

# ===== MinIO / S3 =====
# Không kèm http://
MINIO_ENDPOINT=localhost:9000
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD của container (mật khẩu >= 8 ký tự)
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# Runtime dùng SA riêng, tạo bằng app.infra.minio.service_accounts (xem docs).
# Secrets nằm trong .env.bronze-accounts.local / .env.source-reader.local,
# Compose nạp .env.bronze-backend.local và .env.bronze-worker.local theo service.
# Không đặt credentials root vào các file runtime này.

# ===== DuckDB =====
# :memory: cho backend (tránh khóa file); dùng đường dẫn file cho notebook/debug
DUCKDB_PATH=:memory:
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=2GB

# ===== JWT =====
# Production: tạo bằng `openssl rand -hex 32`
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== LLM =====
# mock | openai | anthropic (hiện backend luôn dùng mock)
LLM_PROVIDER=mock
# Điền key thật chỉ trong .env local, KHÔNG điền vào .env.example
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
