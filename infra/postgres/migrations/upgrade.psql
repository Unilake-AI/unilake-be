DO $$
DECLARE relation_name text;
BEGIN
    FOREACH relation_name IN ARRAY ARRAY[
        'app.canonical_identity', 'app.identity_crosswalk', 'app.crosswalk_release',
        'app.gold_sync_job','app.gold_record_identity','app.business_import_change',
        'app.admission_event','app.admission_correction',
        'app.auto_pipeline_job', 'app.cleaning_run', 'app.gold_job', 'app.gold_scope',
        'app.gold_attempt', 'app.gold_worker', 'gold.aggregate', 'gold.current_metrics',
        'app.notification_read', 'app.catalog_metadata'
    ] LOOP
        IF to_regclass(relation_name) IS NULL THEN
            RAISE EXCEPTION 'SCHEMA_NOT_READY: missing %', relation_name;
        END IF;
    END LOOP;
    IF EXISTS(SELECT 1 FROM pg_tables WHERE schemaname='app' AND left(tablename,7)='silver_') THEN
        RAISE EXCEPTION 'SCHEMA_NOT_READY: legacy Silver tables remain';
    END IF;
    IF (SELECT count(*) FROM app.data_layer WHERE layer_code IN ('BRONZE','SILVER','GOLD')) <> 3 THEN
        RAISE EXCEPTION 'SCHEMA_NOT_READY: missing data layers';
    END IF;
    IF to_regprocedure('app.enqueue_default_silver(bigint)') IS NULL
       OR to_regprocedure('app.enqueue_gold_object(text,text,jsonb)') IS NULL THEN
        RAISE EXCEPTION 'SCHEMA_NOT_READY: missing pipeline functions';
    END IF;
END $$;
SELECT pg_advisory_unlock(hashtextextended('unilake.schema.upgrade', 0));
\echo UniLake schema upgrade completed.
