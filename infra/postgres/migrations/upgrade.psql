-- Điểm nâng cấp chung cho DB mới và volume hiện có. Chạy bằng psql, không bằng ORM.
-- Mỗi migration tự quản lý transaction; ON_ERROR_STOP dừng ngay khi có lỗi.
-- Chạy lại toàn bộ an toàn, kể cả DB cũ chưa có bảng lịch sử migration.
\set ON_ERROR_STOP on
\if :{?base_schema_file}
\else
\set base_schema_file /docker-entrypoint-initdb.d/02-schema.sql
\endif
SET lock_timeout = '15s';
SET statement_timeout = '120s';
SELECT pg_advisory_lock(hashtextextended('unilake.schema.upgrade', 0));
-- DB cũ đã có bảng lõi dùng ALTER của migration, tránh tạo index lên cột chưa nâng cấp.
SELECT to_regclass('app.ingestion_job') IS NULL AS needs_base_schema \gset
\if :needs_base_schema
\i :base_schema_file
\endif
CREATE TABLE IF NOT EXISTS app.schema_migration (
    migration_name VARCHAR(200) PRIMARY KEY,
    applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

\echo Applying 20261015_ingestion_execution.sql
\ir 20261015_ingestion_execution.sql
INSERT INTO app.schema_migration (migration_name) VALUES ('20261015_ingestion_execution.sql') ON CONFLICT DO NOTHING;

