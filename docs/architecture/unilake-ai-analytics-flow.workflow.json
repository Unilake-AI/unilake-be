    { "dot": "rose", "title": "An toàn và phục hồi", "items": ["SQL do LLM sinh phải qua SQL Validation trước khi chạy", "SQL sai được sửa và thử lại có giới hạn, đề xuất tối đa 2 lần, hết lượt thì báo lỗi (FR21)"] },
    { "dot": "cyan", "title": "Grounding và ổn định", "items": ["Schema từ Data Catalog đi vào prompt, LLM không đoán bảng", "LLM gọi qua lớp trừu tượng có fallback, mọi truy vấn lưu Query History (FR20)"] }
